    function _parseModes(): void { const mraw = modesFile.text().trim(); if (!mraw) return; try { const m = JSON.parse(mraw); if (m && m.workspaces) root.wsModes = m.workspaces; if (m && m.default) root.defaultWsMode = m.default; } catch (e) {} }
    function reloadDock(): void { modesFile.reload(); root._parseModes(); } function wsModeFor(wsId): string { const k = String(wsId); return (root.wsModes && root.wsModes[k]) ? root.wsModes[k] : root.defaultWsMode; }
    Process { id: clientsProc; command: ["sh", "-c", "hyprctl clients -j 2>/dev/null || echo '[]'"]; stdout: StdioCollector { onStreamFinished: { try { const arr = JSON.parse(text.trim() || "[]"); root.clients = arr.filter(c => c.mapped && c.workspace && (c.workspace.id > 0 || String(c.workspace.name || "").includes("minimized"))); } catch (e) {} } } }
    Connections { target: Hyprland; function onRawEvent(event) { const n = String(event.name || ""); if (n.includes("window") || n.includes("workspace") || n.includes("focusedmon")) clientsProc.running = true; } }
    Component.onCompleted: { root.reloadDock(); root.reloadBarIcons(); root._parseSuperBar(); root.reloadForge(); root.reloadSfx(); root.reloadWebcam(); clientsProc.running = true; rgbProbeProc.running = true; root.refresh(); }
    IpcHandler { target: "dock"; function reload(): void { root.reloadDock(); root.reloadForge(); clientsProc.running = true; } function toggleApps(): void { root.appGridOpen = !root.appGridOpen; root.playSfx("click"); } } IpcHandler { target: "workspaces"; function reload(): void { root.reloadDock(); } }
    IpcHandler { target: "settings"; function toggle(): void { root.toggleSettings(""); } function open(page: string): void { root.openSettings(page); } function item(cat: string, id: string): void { root.openSettingsItem(cat, id, ""); } function saveProfile(name: string, mail: string, dev: string, git: string, ws: string, role: string): void { root.saveUserProfile(name, mail, dev, git, ws, role); } function close(): void { root.settingsOpen = false; } }
    IpcHandler { target: "forge"; function toggle(): void { root.toggleForgeGui(); } function open(tab: string): void { root.openForgeGui(tab); } function close(): void { root.forgeGuiOpen = false; } } IpcHandler { target: "panels"; function settings(): void { root.toggleSettings(""); } } IpcHandler { target: "status"; function refresh(): void { root.refresh(); } function reloadBar(): void { root.reloadBarIcons(); root._parseSuperBar(); } function reloadForge(): void { root.reloadForge(); } function mockForge(): void { root.runMockForge(""); } function flyout(m: string): void { root.flyoutReqMode = m; root.flyoutReqSeq += 1; } }
    IpcHandler { target: "superbaredge"; function cmd(args: string): void { root.runSuperBarCmd(args); } function run(args: string): void { root.runSuperBarCmd(args); } function reload(): void { root._parseSuperBar(); } function config(): string { return JSON.stringify(root.superbarConfig); } }
    Timer { interval: 500; running: root.forgeBusy || root.forgeRecent; repeat: true; onTriggered: { root.reloadForge(); if (root.forgeBusy) forgeTailProc.running = true; } } Timer { interval: 8000; running: root.settingsOpen || root.pocketOpen || root.appGridOpen; repeat: true; onTriggered: root.refresh() }
    function refresh() { if (netProc.running) root._refreshQueued = true; else netProc.running = true; tzProc.running = true; clientsProc.running = true; root.reloadForge(); root.reloadSfx(); }
