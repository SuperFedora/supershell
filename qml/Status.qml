            "pf=~/.config/superfedora/profile.env; USER_FULLNAME=''; USER_EMAIL=''; USER_AVATAR=''; USER_DEVICE_NAME=''; USER_GITHUB=''; USER_WORKSPACE='~/Projects'; USER_AI_ROLE=''; [ -f \"$pf\" ] && . \"$pf\" 2>/dev/null || true; [ -n \"$USER_FULLNAME\" ] || USER_FULLNAME=$(git config --global user.name 2>/dev/null || getent passwd \"$USER\" 2>/dev/null | cut -d: -f5 | cut -d, -f1 || true); [ -n \"$USER_EMAIL\" ] || USER_EMAIL=$(git config --global user.email 2>/dev/null || true); av=${USER_AVATAR/#\\~/$HOME}; for c in \"$av\" ~/.config/superfedora/avatar.png ~/.face ~/Pictures/Wallpapers/avatar.jpg; do [ -n \"$c\" ] && [ -f \"$c\" ] && { av=\"$c\"; break; }; done; printf 'PRF|%s|%s|%s|%s|%s|%s|%s\\n' \"$USER_FULLNAME\" \"$USER_EMAIL\" \"$av\" \"$USER_DEVICE_NAME\" \"$USER_GITHUB\" \"${USER_WORKSPACE:-~/Projects}\" \"$USER_AI_ROLE\"; for a in ~/Pictures/Wallpapers/avatar.jpg ~/.face ~/Pictures/Avatars/* ~/Pictures/*.png ~/Pictures/*.jpg ~/Pictures/Wallpapers/dark/*.png; do [ -f \"$a\" ] && echo \"AVT|$a\"; done | awk '!seen[$0]++' | head -n 8; " +
