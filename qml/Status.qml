                    if (lines[i].startsWith("CAM|")) { const cv = (lines[i].split("|")[1] || "on").trim().toLowerCase(); root.webcamEnabled = (cv !== "off" && cv !== "0" && cv !== "false"); continue; }
                    if (lines[i].startsWith("KBD|")) { root.kbdBacklight = Math.max(0, Math.min(2, Number(lines[i].split("|")[1] || 0))); continue; } if (lines[i].startsWith("DSCL|")) { const p = lines[i].split("|"); if (parseFloat(p[1]) > 0) root.displayScale = parseFloat(p[1]); if (parseFloat(p[2]) > 0) root.cursorZoom = parseFloat(p[2]); if (p[3] !== undefined) root.touchpadNaturalScroll = p[3] !== "0"; if (p[4] !== undefined) root.touchpadTapToClick = p[4] !== "0"; if (p[5] !== undefined && !isNaN(parseFloat(p[5]))) root.pointerSensitivity = parseFloat(p[5]); if (p[6] !== undefined && !isNaN(Number(p[6]))) root.kbdRepeatFast = Number(p[6]) >= 40; if (p[7] !== undefined) root.gapsEnabled = !String(p[7]).trim().startsWith("0"); continue; }
